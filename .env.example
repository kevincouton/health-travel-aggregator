# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- Postgres ---
POSTGRES_USER=health_travel
# Generate a real password: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health_travel

# --- API server ---
# Session signing key, min 32 bytes: openssl rand -hex 32
SESSION_SIGNING_KEY=change-me-min-32-bytes-long
# Public URL of the web app (also an allowed Origin for mutating API calls)
APP_URL=http://localhost:3000
# Browser origin allowed to call the API cross-origin (CORS). Empty = CORS off.
CORS_ORIGIN=http://localhost:3000
# Sentry/GlitchTip DSN for the Rust server. Empty = error capture disabled.
SENTRY_DSN=
# Per-IP rate limits (requests per minute) for auth endpoints and public
# write endpoints (inquiries, reviews).
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=30

# --- Web frontend ---
NUXT_PUBLIC_API_URL=http://localhost:8080
# Sentry/GlitchTip DSN for the Nuxt app. Empty = error capture disabled.
NUXT_PUBLIC_SENTRY_DSN=
