DATABASE_URL=postgres://health_travel:change-me@localhost:5432/health_travel
APP_URL=http://localhost:3000
# Min 32 bytes: openssl rand -hex 32
SESSION_SIGNING_KEY=change-me-min-32-bytes-long
# Browser origin allowed to call the API cross-origin. Empty = CORS off.
CORS_ORIGIN=http://localhost:3000
# Sentry/GlitchTip DSN. Empty = error capture disabled.
SENTRY_DSN=
# Per-IP rate limits (requests per minute).
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=30

# --- SMTP email (magic links, inquiry notifications) ---
# Unset SMTP_HOST = mock sender (messages recorded in memory, not delivered).
# Set it to go live; see ../docs/ACTIVATION.md.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# From address, e.g. "Health Travel <no-reply@yourdomain.com>"
SMTP_FROM=
# starttls (default, port 587) | tls (implicit, port 465) | off
SMTP_TLS=

# --- Stripe billing ---
# Unset STRIPE_SECRET_KEY = mock payment provider (dev/CI unaffected).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
